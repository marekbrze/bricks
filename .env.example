# Copy to `.env.local` and fill in. Every value here ships in the client bundle —
# public identifiers only, never a secret.

# Unsplash Access Key (the public Client-ID) for the Vision board's photo search.
# Create a free app at https://unsplash.com/oauth/applications.
# Optional: leave it unset and the app asks for a key in the search dialog,
# storing it in that browser only. Never put the Secret Key here.
VITE_UNSPLASH_ACCESS_KEY=
